# Site configuration for a review runner. Copy to local.conf and edit.
# Not in git: it names your hosts, paths and accounts.

# Where finished reports are rsynced. Either an rsync-daemon URL with a password
# file, or an ssh destination with no auth option:
#   REVIEW_PUBLISH="rsync://reports@webhost"
#   RSYNC_AUTH="--password-file=$HOME/review/etc/rsync.password"
# or
#   REVIEW_PUBLISH="webhost:public_html/reviews"
#   RSYNC_AUTH=""
REVIEW_PUBLISH="rsync://reports@webhost"
RSYNC_AUTH="--password-file=$HOME/review/etc/rsync.password"

# The public base URL those reports appear at. The command links to it from the
# PR comments it posts, and reads back its own previous reports from it.
REVIEW_PUBLIC_URL="https://reviews.example.org"

# Name shown on the runs dashboard. Defaults to the short hostname.
#REVIEW_BOX_NAME="runner1"

# Accounts are not configured here. Each one is a directory under
# $HOME/review.auth, and a symlink says which account each role uses:
#
#   review-auth.sh status                        what every role resolves to
#   review-auth.sh login claude personal         how to sign an account in
#   review-auth.sh use claude default personal   move a role to another account
#
# The rsync role covers the non-ArduPilot target; everything else is default.

# Accounts whose AI comments count as ours, space separated, newest first. The
# account you post as now, plus any it replaced - otherwise comments posted
# before an account switch stop being recognised and get duplicated.
#REVIEW_COMMENT_ACCOUNTS="AP-Review tridge"

# Token for the account that posts comments (classic PAT, public_repo scope). gh
# prefers this over its keyring, so a runner can post as a bot without changing
# the box's interactive login. review-env.sh exports it for you.
#GH_TOKEN="ghp_..."

# Last day the handover job (deprecate-legacy-comments.sh) does anything. After
# it the bot is the only account, and that job and its cron line can go.
#REVIEW_DEPRECATE_UNTIL="2026-09-30"
